# Copy to .env and fill in your own values.
# Note: no script calls load_dotenv() — export these into the shell before running,
# e.g. `set -a && source .env && set +a`

# GPT-4 evaluation (code/code/GPT4_evaluation.ipynb)
OPENAI_API_KEY=

# Gated HF models such as meta-llama/Llama-2-* (code/code/Citations/scripts/run_2.sh)
HUGGING_FACE_HUB_TOKEN=

# GPU selection -- leave commented on Slurm: it overrides the GPUs the job was
# allocated, so a --gres=gpu:2 job would see only one (AutoAIS needs two 24GB cards).
# CUDA_VISIBLE_DEVICES=0
